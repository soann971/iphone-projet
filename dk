#!/usr/bin/env python3
"""devkit — point d'entrée.

Lanceur autonome : on ajoute le dossier du script au sys.path puis on délègue
au CLI. Aucune installation requise — `./dk ...` fonctionne depuis un clone git.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from devkit.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
