# =====================================================================
#  Configuration — copiez ce fichier en .env et complétez.
#  Ne commitez JAMAIS le fichier .env (il est ignoré par git).
#  En production, préférez un gestionnaire de secrets (voir docs/deploiement.md).
# =====================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Base de données et Redis (docker-compose les fournit automatiquement) ---
DATABASE_URL=postgresql://ms:ms-local-only@localhost:5432/mail_support
REDIS_URL=redis://localhost:6379
POSTGRES_PASSWORD=ms-local-only

# --- URLs publiques ---
# URL de l'API vue depuis Internet (webhooks Pub/Sub et Shopify).
APP_BASE_URL=http://localhost:4000
# URL du dashboard (retour après connexion Gmail).
DASHBOARD_URL=http://localhost:3000

# --- Secrets applicatifs (générez-les : voir les commandes) ---
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -base64 48
SESSION_SECRET=

# Premier administrateur créé au démarrage (mot de passe : 12 caractères minimum).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Google / Gmail (docs/google-cloud.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doit pointer vers le DASHBOARD (qui relaie vers l'API) et être déclarée dans Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
# projects/<id-projet>/topics/gmail-notifications
GMAIL_PUBSUB_TOPIC=
# Compte de service utilisé par l'abonnement push (vérification du jeton OIDC).
PUBSUB_SERVICE_ACCOUNT=
# Audience configurée sur l'abonnement push (par défaut : APP_BASE_URL/webhooks/gmail).
PUBSUB_AUDIENCE=
# true UNIQUEMENT en local si vous simulez les notifications.
PUBSUB_SKIP_VERIFY=false

# --- IA : Claude (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT_CLASSIFY=low
AI_EFFORT_DRAFT=medium
AI_FALLBACKS=true

# --- Shopify (docs/shopify.md) ---
SHOPIFY_STORE_DOMAIN=ma-boutique.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Uniquement si vous avez une ancienne "app personnalisée" (jeton shpat_…).
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Uniquement si vos webhooks sont signés avec un autre secret que SHOPIFY_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=

# --- Transporteurs (facultatif : sinon statut Shopify uniquement) ---
# https://developer.laposte.fr (API Suivi) — Colissimo, Chronopost, La Poste
LAPOSTE_API_KEY=
# https://api.17track.net — Mondial Relay, DPD, GLS, UPS, DHL…
SEVENTEENTRACK_API_KEY=

STORAGE_DIR=./storage
